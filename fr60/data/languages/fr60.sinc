:LDM0 "("^ldm0_list^")" is op8=0x8C & ldm0_list {
    build ldm0_list;
}

:LDM1 "("^ldm1_list^")" is op8=0x8D & ldm1_list {
    build ldm1_list;
}

:STM0 "("^stm0_list^")" is op8=0x8E & stm0_list {
    build stm0_list;
}

:STM1 "("^stm1_list^")" is op8=0x8F & stm1_list {
    build stm1_list;
}

:XCHB "@"^rj, ri is op8=0x8A & rj & ri {
	local data:1 = *:1 rj;
	*:1 rj = ri:1;
	ri = zext(data);
}

:JMP "@"^ri is op12=0x970 & ri {
	goto [ri];	
}

:CALL label12 is op5=0x1A & label12 {
	RP = inst_next;
	call label12;
}

:CALL "@"^ri is op12=0x971 & ri {	
	RP = inst_next;
	call [ri];
}

:RET is op16=0x9720 {
	return [RP];
}

:INT "#"^u8 is op8=0x1F & u8 {
	SP = SP - 4;
	*:4 SP = PS;
	SP = SP - 4;
	*:4 SP = inst_next;
	S = 0;
	I = 0;
	
	local u:4 = u8;
	local addr:4 = TBR + 0x03FC - u * 4;
	local data:4 = *:4 addr;

	goto [data];
}

:INTE is op16=0x9F30 {
	SP = SP - 4;
	*:4 SP = PS;
	SP = SP - 4;
	*:4 SP = inst_next;
	ILM = 0;
	S = 0;

	local addr:4 = TBR + 0x3D8;
	local data:4 = *:4 addr;

	goto [data];
}

:RETI is op16=0x9730 {
    local addr:4;
    local pcdata:4;
    local psdata:4;

    addr = SP;

    pcdata = *:4 addr;
    addr = addr + 4;

    psdata = *:4 addr;
    addr = addr + 4;

    SP = addr;
    write_ps(psdata);
    return [pcdata];
}

condition: "EQ" is cc=0x2 {
    local take:1 = (Z == 1);
    export take;
}

condition: "NE" is cc=0x3 {
    local take:1 = (Z == 0);
    export take;
}

condition: "C" is cc=0x4 {
    local take:1 = (C == 1);
    export take;
}

condition: "NC" is cc=0x5 {
    local take:1 = (C == 0);
    export take;
}

condition: "N" is cc=0x6 {
    local take:1 = (N == 1);
    export take;
}

condition: "P" is cc=0x7 {
    local take:1 = (N == 0);
    export take;
}

condition: "V" is cc=0x8 {
    local take:1 = (V == 1);
    export take;
}

condition: "NV" is cc=0x9 {
    local take:1 = (V == 0);
    export take;
}

condition: "LT" is cc=0xA {
    local take:1 = ((V ^ N) == 1);
    export take;
}

condition: "GE" is cc=0xB {
    local take:1 = ((V ^ N) == 0);
    export take;
}

condition: "LE" is cc=0xC {
    local take:1 = (((V ^ N) | Z) == 1);
    export take;
}

condition: "GT" is cc=0xD {
    local take:1 = (((V ^ N) | Z) == 0);
    export take;
}

condition: "LS" is cc=0xE {
    local take:1 = ((C | Z) == 1);
    export take;
}

condition: "HI" is cc=0xF {
    local take:1 = ((C | Z) == 0);
    export take;
}
:BRA label9 is op4=0xE & cc=0x0 & label9 {
	goto label9;
}

:BNO label9 is op4=0xE & cc=0x1 & label9 {
	# never taken
}

:B^condition label9 is op4=0xE & condition & label9 {
    build condition;
    if (condition == 0) goto <done>;
    goto label9;
    <done>
}

:JMP^":D" "@"^ri is op12=0x9F0 & ri {
	delayslot(1);
	goto [ri];	
}

:CALL^":D" label12 is op5=0x1B & label12 {
	RP = inst_next;
	delayslot(1);
	call label12;
}

:CALL^":D" "@"^ri is op12=0x9F1 & ri {	
	RP = inst_next;
	delayslot(1);
	call [ri];
}

:RET^":D" is op16=0x9F20 {	
	delayslot(1);
	return [RP];
}

:BRA^":D" label9 is op4=0xF & cc=0x0 & label9 {	
	delayslot(1);
	goto label9;
}

:BNO^":D" label9 is op4=0xF & cc=0x1 & label9 {	
	delayslot(1);
	# never taken
}

:B^condition^":D" label9 is op4=0xF & condition & label9 {
    build condition;
    delayslot(1);
    if (condition == 0) goto <done>;
    goto label9;
    <done>
}

:NOP is op16=0x9FA0 {
	#does nothing
}

:ENTER "#"^dir10 is op8=0x0F & dir10 {
	*:4 (SP - 4) = FP;
	FP = SP - 4;
	SP = SP - dir10;
}

:LEAVE is op16=0x9F90 {
    local data:4;

	SP = FP + 4;
    data = *:4 (SP - 4);
    FP = data;
}

:LDRES "@"^ri^"+, #"^u4 is op8=0xBC & u4 & ri {
    local data:4;
    local u:1 = u4;

    data = *:4 ri;
    LDRES_OP(u, data);
    ri = ri + 4;
}

:STRES "#"^u4^", @"^ri^"+" is op8=0xBD & u4 & ri {
    local data:4;
    local u:1 = u4;

    data = STRES_OP(u);
    *:4 ri = data;
    ri = ri + 4;
}

:COPOP "#"^cpu4, "#"^cpc, cprj, cpri is op12=0x9FC & cpu4 ; cpc & cprj & cpri {
    local CPu:1 = cpu4;
    local cmd:1 = cpc;
    local cri:1 = cpri;
    local crj:1 = cprj;
	COPOP(CPu, cmd, crj, cri);
}

:COPLD "#"^cpu4, "#"^cpc, rj, cpri is op12=0x9FD & cpu4 ; cpc & rj & cpri {
    local CPu:1 = cpu4;
    local cmd:1 = cpc;
    local cri:1 = cpri;
    COPLD(CPu, cmd, cri, rj);
}
	
:COPST "#"^cpu4, "#"^cpc, cprj, ri is op12=0x9FE & cpu4 ; cpc & cprj & ri {
	local data:4;
    local CPu:1 = cpu4;
    local cmd:1 = cpc;
    local crj:1 = cprj;
    data = COPST(CPu, cmd, crj);
    ri = data;
}
	
:COPSV "#"^cpu4, "#"^cpc, cprj, ri is op12=0x9FF & cpu4 ; cpc & cprj & ri {
	local data:4;
    local CPu:1 = cpu4;
    local cmd:1 = cpc;
    local crj:1 = cprj;
    data = COPSV(CPu, cmd, crj);
    ri = data;
}