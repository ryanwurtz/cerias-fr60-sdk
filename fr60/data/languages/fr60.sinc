#instruction tokens & bitfields
define token instr(16)
	op16 = (0,15)
	op12 = (4,15)
    op8 = (8,15)
    op5 = (11,15)
    op4 = (12,15)

    cc = (8,11)

  	u8 = (0,7)
    u4 = (4,7)
    i16 = (0,15)
    i8 = (4,11)
    s8 = (4,11) signed

    rel11 = (0,10) signed
    rel8 = (0,7) signed

    rj = (4,7)
    ri = (0,3)
    rsh = (4,7)
    rsl = (0,3)

    cprj = (4,7)
    cpri = (0,3)
    cpc = (8,15)
    cpu4 = (0,3)
	
    listbit0 = (0,0)
    listtail0 = (1,7)
    listbit1 = (1,1)
    listtail1 = (2,7)
    listbit2 = (2,2)
    listtail2 = (3,7)
    listbit3 = (3,3)
    listtail3 = (4,7)
    listbit4 = (4,4)
    listtail4 = (5,7)
    listbit5 = (5,5)
    listtail5 = (6,7)
    listbit6 = (6,6)
    listtail6 = (7,7)
    listbit7 = (7,7)
;

define token imm(32)
	i32 = (0,31)
;

# attaching token vars to declared registers
# SSP -> SP for split stack simplification
attach variables [ ri rj ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 AC FP SP ];
attach variables [ rsh rsl ] [ TBR RP SP USP MDH MDL _ _ _ _ _ _ _ _ _ _ ];

# pcode OPs for channel resource and coprocessor instructions
define pcodeop LDRES_OP;
define pcodeop STRES_OP;
define pcodeop COPOP;
define pcodeop COPLD;
define pcodeop COPST;
define pcodeop COPSV;

# bitfield subtables
n4: value is u4 [ value = u4 - 16; ] {
    export *[const]:4 value;
}

i20: value is u4 ; i16 [ value = (u4 << 16) | i16; ] {
    export *[const]:4 value;
}

disp10: value is s8 [ value = s8 * 4; ] {
	export *[const]:4 value;
}

disp9: value is s8 [ value = s8 * 2; ] {
	export *[const]:4 value;
}

udisp6: value is u4 [ value = u4 * 4; ] {
	export *[const]:4 value;
}

label12: target is rel11 [ target = inst_next + (rel11 * 2); ] {
    export *[ram]:4 target;
}

label9: target is rel8 [ target = inst_next + (rel8 * 2); ] {
	export *[ram]:4 target;
}

dir10: value is u8 [ value = u8 * 4; ] {
	export *[const]:4 value;
}

dir9: value is u8 [ value = u8 * 2; ] {
	export *[const]:4 value;
}

macro write_ps(value) {
    local oldilm:1 = ILM;
    local ilmvalue:4 = (value >> 16) & 0x1F;
	local newilm:1 = ilmvalue:1;
    local data:4 = value;

    if (oldilm < 16) goto <load>;
    if (newilm >= 16) goto <load>;

    data = data | 0x00100000;

	<load>
    PS = data;
}

macro set_nz(result) {
	N = (result s< 0);
	Z = (result == 0);
}

macro set_add_flags(a, b, result) {
	set_nz(result);
	C = carry(a, b);
	V = scarry(a, b);
}

macro set_addc_flags(a, b, cin, result) {
    local temp:4 = a + b;

    set_nz(result);

    C = carry(a, b) | carry(temp, cin);
    V = scarry(a, b) ^ scarry(temp, cin);
}

macro set_sub_flags(a, b, result) {
	set_nz(result);
	C = a < b;
	V = sborrow(a, b);
}

macro set_subc_flags(a, b, cin, result) {
    local temp:4 = a - b;

    set_nz(result);

    C = (a < b) | (temp < cin);
    V = sborrow(a, b) ^ sborrow(temp, cin);
}

macro left_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (32-shift)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

macro right_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (shift-1)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

:ADD rj, ri is op8=0xA6 & rj & ri {	
	local result:4 = ri + rj;
	set_add_flags(ri,rj,result);
	ri = result;
}

:ADD "#"^u4, ri is op8=0xA4 & u4 & ri {	
	local u:4 = u4;
	local result:4 = ri + u;
	set_add_flags(u,ri,result);
	ri = result;
}

:ADD2 "#"^n4, ri is op8=0xA5 & n4 & ri {
    local result:4 = ri + n4;
    set_add_flags(ri, n4, result);
	ri = result;
}

:ADDC rj, ri is op8=0xA7 & rj & ri {
    local cin:4 = zext(C);
    local result:4 = ri + rj + cin;
    set_addc_flags(ri, rj, cin, result);
    ri = result;
}

:ADDN rj, ri is op8=0xA2 & rj & ri {
	ri = ri + rj;
}

:ADDN "#"^u4, ri is op8=0xA0 & u4 & ri {
	local u:4 = u4;
	ri = ri + u;
}

:ADDN2 "#"^n4, ri is op8=0xA1 & n4 & ri {
    ri = ri + n4;
}

:SUB rj, ri is op8=0xAC & rj & ri {
	local result:4 = ri - rj;
	set_sub_flags(ri,rj,result);
	ri = result;
}

:SUBC rj, ri is op8=0xAD & rj & ri {	
    local cin:4 = zext(C);
    local result:4 = ri - rj - cin;
    set_subc_flags(ri,rj,cin,result);
    ri = result;
}

:SUBN rj, ri is op8=0xAE & rj & ri {
	ri = ri - rj;
}

:CMP rj, ri is op8=0xAA & rj & ri {	
	local result:4 = ri - rj;
	set_sub_flags(ri,rj,result);
}

:CMP "#"^u4, ri is op8=0xA8 & u4 & ri {
	local u:4 = u4;
	local result:4 = ri - u;
	set_sub_flags(ri,u,result);
}

:CMP2 "#"^n4, ri is op8=0xA9 & n4 & ri {
    local result:4 = ri - n4;
    set_sub_flags(ri, n4, result);
}

:STILM "#"^u8 is op8=0x87 & u8 {
    local old:1 = ILM;
    local new:1 = u8 & 0x1F;

    if (old < 16) goto <load>;
    if (new >= 16) goto <load>;

    new = new + 16;

	<load>
    ILM = new;
}

:ADDSP "#"^disp10 is op8=0xA3 & disp10 {
	SP = SP + disp10;
}

:AND rj, ri is op8=0x82 & rj & ri {	
	local result:4 = rj & ri;
	set_nz(result);
	ri = result;
}

:AND rj, "@"^ri is op8=0x84 & rj & ri {	
	local result:4 = rj & (*:4 ri);
	set_nz(result);
	*:4 ri = result;
}

:ANDH rj, "@"^ri is op8=0x85 & rj & ri {	
	local result:2 = rj:2 & (*:2 ri);
	set_nz(result);
	*:2 ri = result;
}

:ANDB rj, "@"^ri is op8=0x86 & rj & ri {
	local result:1 = rj:1 & (*:1 ri);
	set_nz(result);
	*:1 ri = result;
}

:OR rj, ri is op8=0x92 & rj & ri {	
	local result:4 = rj | ri;
	set_nz(result);
	ri = result;
}

:OR rj, "@"^ri is op8=0x94 & rj & ri {
	local result:4 = rj | (*:4 ri);
	set_nz(result);
	*:4 ri = result;
}

:ORH rj, "@"^ri is op8=0x95 & rj & ri {
	local result:2 = rj:2 | (*:2 ri);
	set_nz(result);
	*:2 ri = result;
}

:ORB rj, "@"^ri is op8=0x96 & rj & ri {
	local result:1 = rj:1 | (*:1 ri);
	set_nz(result);
	*:1 ri = result;
}

:EOR rj, ri is op8=0x9A & rj & ri {
	local result:4 = rj ^ ri;
	set_nz(result);
	ri = result;
}

:EOR rj, "@"^ri is op8=0x9C & rj & ri {
	local result:4 = rj ^ (*:4 ri);
	set_nz(result);
	*:4 ri = result;
}

:EORH rj, "@"^ri is op8=0x9D & rj & ri {
	local result:2 = rj:2 ^ (*:2 ri);
	set_nz(result);
	*:2 ri = result;
}

:EORB rj, "@"^ri is op8=0x9E & rj & ri {
	local result:1 = rj:1 ^ (*:1 ri);
	set_nz(result);
	*:1 ri = result;
}

:BANDL "#"^u4, "@"^ri is op8=0x80 & u4 & ri {
	local u:1 = u4;
	*:1 ri = (0xF0 | u) & (*:1 ri);
}

:BANDH "#"^u4, "@"^ri is op8=0x81 & u4 & ri {
	local u:1 = u4;
	*:1 ri = (0x0F | (u << 4)) & (*:1 ri);
}

:BORL "#"^u4, "@"^ri is op8=0x90 & u4 & ri {
	local u:1 = u4;
	*:1 ri = u | (*:1 ri);
}

:BORH "#"^u4, "@"^ri is op8=0x91 & u4 & ri {	
	local u:1 = u4;
	*:1 ri = (u << 4) | (*:1 ri);
}

:BEORL "#"^u4, "@"^ri is op8=0x98 & u4 & ri {
	local u:1 = u4;
	*:1 ri = u ^ (*:1 ri);
}

:BEORH "#"^u4, "@"^ri is op8=0x99 & u4 & ri {
	local u:1 = u4;
	*:1 ri = (u << 4) ^ (*:1 ri);
}

:BTSTL "#"^u4, "@"^ri is op8=0x88 & u4 & ri {
	local u:1 = u4;
	local result:1 = u & (*:1 ri);
	set_nz(result);
}

:BTSTH "#"^u4, "@"^ri is op8=0x89 & u4 & ri {
	local u:1 = u4;
	local result:1 = (u << 4) & (*:1 ri);
	set_nz(result);
}

:ANDCCR "#"^u8 is op8=0x83 & u8 {
	CCR = CCR & u8;
}

:ORCCR "#"^u8 is op8=0x93 & u8 {
	CCR = CCR | u8;
}

:EXTSB ri is op12=0x978 & ri {	
	ri = sext(ri:1);
}

:EXTUB ri is op12=0x979 & ri {	
	ri =  zext(ri:1);
}

:EXTSH ri is op12=0x97A & ri {
	ri = sext(ri:2);
}

:EXTUH ri is op12=0x97B & ri {	
	ri = zext(ri:2);
}

:MUL rj, ri is op8=0xAF & rj & ri {	
	local result:8 = sext(rj) * sext(ri);
	
	MDH = result(4);
    MDL = result:4;

    N = (MDL s< 0);
    Z = (result == 0);
    V = (result != sext(MDL));
}

:MULU rj, ri is op8=0xAB & rj & ri {		
	local result:8 = zext(rj) * zext(ri);
	
	MDH = result(4);
    MDL = result:4;

    N = (MDL s< 0);
    Z = (MDL == 0);
    V = (MDH != 0);
}

:MULH rj, ri is op8=0xBF & rj & ri {	
	local result:4 = sext(rj:2) * sext(ri:2);
	MDL = result;
	set_nz(result);
}

:MULUH rj, ri is op8=0xBB & rj & ri {	
	local result:4 = zext(rj:2) * zext(ri:2);
	MDL = result;
	set_nz(result);
}

:DIV0S ri is op12=0x974 & ri {	
	D0 = (MDL s< 0);
	D1 = ((MDL s<0) ^ (ri s<0));

	local extended:8 = sext(MDL);
	MDH = extended(4);
}

:DIV0U ri is op12=0x975 & ri {	
	D0 = 0;
	D1 = 0;
	MDH = 0;
}

:DIV1 ri is op12=0x976 & ri {	
	local comb:8 = (zext(MDH) << 32) | zext(MDL);
	comb = comb << 1;
	MDH = comb(4);
	MDL = comb:4;
	
	local temp:4;
	if (D1 == 1) goto <add>;
	temp = MDH - ri;
	C = MDH < ri;
	goto <check>;
	<add>
	temp = MDH + ri;
	C = carry(MDH, ri);
	
	<check>
	if ((D0 ^ D1 ^ C) != 0) goto <done>;
	MDH = temp;
	MDL = MDL | 0x1;
	<done>
	Z = (MDH == 0);
}

:DIV2 ri is op12=0x977 & ri {	
	local temp:4;
	if (D1 == 1) goto <add>;
	temp = MDH - ri;
	C = MDH < ri;
	goto <check>;
	<add>
	temp = MDH + ri;
	C = carry(MDH, ri);
	
	<check>
	Z = (temp == 0);
	
	if (Z != 1) goto <done>;
	MDH = 0;
	<done>
}

:DIV3 is op16=0x9F60 {	
	if (Z != 1) goto <done>;
	MDL = MDL + 1;
	<done>
}

:DIV4S is op16=0x9F70 {	
	if (D1 != 1) goto <done>;
	MDL = 0 - MDL;
	<done>
}

:LSL rj, ri is op8=0xB6 & rj & ri {	
	local shift:1 = rj:1 & 0x1F;
	local result:4 = ri << shift;
	
	left_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:LSL "#"^u4, ri is op8=0xB4 & u4 & ri {	
	local u:4 = u4;
	local result:4 = ri << u;
	
	left_setc(u, ri);
	ri = result;
	set_nz(result);
}

:LSL2 "#"^u4, ri is op8=0xB5 & u4 & ri {	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = ri << shift;
	
	left_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:LSR rj, ri is op8=0xB2 & rj & ri {	
	local shift:1 = rj:1 & 0x1F:1;
	local result:4 = ri >> shift;
	
	right_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:LSR "#"^u4, ri is op8=0xB0 & u4 & ri {	
	local u:4 = u4;
	local result:4 = ri >> u;
	
	right_setc(u, ri);
	ri = result;
	set_nz(result);
}

:LSR2 "#"^u4, ri is op8=0xB1 & u4 & ri {	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = ri >> shift;
	
	right_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:ASR rj, ri is op8=0xBA & rj & ri {	
	local shift:1 = rj:1 & 0x1F;
	local result:4 = ri s>> shift;
	
	right_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:ASR "#"^u4, ri is op8=0xB8 & u4 & ri {	
	local u:4 = u4;
	local result:4 = ri s>> u;
	
	right_setc(u, ri);
	ri = result;
	set_nz(result);
}

:ASR2 "#"^u4, ri is op8=0xB9 & u4 & ri {	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = ri s>> shift;
	
	right_setc(shift, ri);
	ri = result;
	set_nz(result);
}

:LDI:32 "#"^i32, ri is op12=0x9F8 & ri ; i32 {
	ri = i32;
}

:LDI:20 "#"^i20, ri is (op8=0x9B & ri) ... & i20 {
	ri = i20;
}

:LDI:8 "#"^i8, ri is op4=0xC & i8 & ri {	
	local i:4 = i8;
	ri = i;
}

:LD "@"^rj, ri is op8=0x04 & rj & ri {
	ri = (*:4 rj);
}

:LD "@(AC, "^rj^")", ri is op8=0x00 & rj & ri {
	ri = (*:4 (rj + AC));
}

:LD "@(FP, "^disp10^")", ri is op4=0x2 & disp10 & ri {
	ri = (*:4 (FP + disp10));
}

:LD "@(SP, "^udisp6^")", ri is op8=0x03 & udisp6 & ri {
	ri = (*:4 (SP + udisp6));
}

:LD "@SP+", ri is op12=0x070 & ri {
	local data:4 = *:4 SP;
	SP = SP + 4;
	ri = data;
}

:LD "@SP+", rsl is op12=0x078 & rsl {
	local data:4 = *:4 SP;
	SP = SP + 4;
	rsl = data;
}

:LD "@SP+, PS" is op16=0x0790 {
    local data:4 = *:4 SP;
    write_ps(data);
	SP = SP + 4;
}

:LDUH "@"^rj, ri is op8=0x05 & rj & ri {	
	ri = zext((*:2 rj));
}

:LDUH "@(AC, "^rj^")", ri is op8=0x01 & rj & ri {
	ri = zext((*:2 (AC + rj)));
}

:LDUH "@(FP, "^disp9^")", ri is op4=0x4 & disp9 & ri {
	ri = zext(*:2 (FP + disp9));
}

:LDUB "@"^rj, ri is op8=0x06 & rj & ri {	
	ri = zext((*:1 rj));
}

:LDUB "@(AC, "^rj^")", ri is op8=0x02 & rj & ri {
	ri = zext((*:1 (AC + rj)));
}

:LDUB "@(FP, "^s8^")", ri is op4=0x6 & s8 & ri {
	ri = zext((*:1 (FP + s8)));
}

:ST ri, "@"^rj is op8=0x14 & rj & ri {
	*:4 rj = ri;
}

:ST ri, "@(AC, "^rj^")" is op8=0x10 & rj & ri {
	*:4 (AC + rj) = ri;
}

:ST ri, "@(FP, "^disp10^")" is op4=0x3 & disp10 & ri {
	*:4 (FP + disp10) = ri;
}

:ST ri, "@(SP, "^udisp6^")" is op8=0x13 & udisp6 & ri {	
	*:4 (SP + udisp6) = ri;
}

:ST ri, "@-SP" is op12=0x170 & ri {	
	local data:4 = ri;
	SP = SP - 4;
	*:4 SP = data;
}

:ST rsl, "@-SP" is op12=0x178 & rsl {
	local data:4 = rsl;
	SP = SP - 4;
	*:4 SP = data;
}

:ST "PS, @-SP" is op16=0x1790 {
	SP = SP - 4;
	*:4 SP = PS;
}

:STH ri, "@"^rj is op8=0x15 & rj & ri {
	*:2 rj = ri:2;
}

:STH ri, "@(AC, "^rj^")" is op8=0x11 & rj & ri {
	*:2 (AC + rj) = ri:2;
}

:STH ri, "@(FP, "^disp9^")" is op4=0x5 & disp9 & ri {
	*:2 (FP + disp9) = ri:2;
}

:STB ri, "@"^rj is op8=0x16 & rj & ri {
	*:1 rj = ri:1;
}

:STB ri, "@(AC, "^rj^")" is op8=0x12 & rj & ri {
	*:1 (AC + rj) = ri:1;
}

:STB ri, "@(FP, "^s8^")" is op4=0x7 & s8 & ri {
	*:1 (FP + s8) = ri:1;
}

:MOV rj, ri is op8=0x8B & rj & ri {
	ri = rj;
}

:MOV rsh, ri is op8=0xB7 & rsh & ri {
	ri = rsh;
}

:MOV "PS", ri is op12=0x171 & ri {
	ri = PS;
}

:MOV ri, rsh is op8=0xB3 & rsh & ri {
	rsh = ri;
}

:MOV ri, "PS" is op12=0x071 & ri {
	write_ps(ri);
}

:DMOV "@"^dir10, "AC" is op8=0x08 & dir10 {
	AC = *:4 dir10;
}

:DMOV "AC", "@"^dir10 is op8=0x18 & dir10 {
	*:4 dir10 = AC;
}

:DMOV "@"^dir10, "@AC+" is op8=0x0C & dir10 {	
	*:4 AC = (*:4 dir10);
	AC = AC + 4;
}

:DMOV "@AC+", "@"^dir10 is op8=0x1C & dir10 {	
	*:4 dir10 = (*:4 AC);
	AC = AC + 4;
}

:DMOV "@"^dir10, "@-SP" is op8=0x0B & dir10 {	
	local data:4 = *:4 dir10;
	SP = SP - 4;
	*:4 SP = data;
}

:DMOV "@SP+", "@"^dir10 is op8=0x1B & dir10 {	
	*:4 dir10 = (*:4 SP);
	SP = SP + 4;
}

:DMOVH "@"^dir9, "AC" is op8=0x09 & dir9 {
	AC = zext(*:2 dir9);
}

:DMOVH "AC", "@"^dir9 is op8=0x19 & dir9 {
	*:2 dir9 = AC:2;
}

:DMOVH "@"^dir9, "@AC+" is op8=0x0D & dir9 {	
	*:2 AC = (*:2 dir9);
	AC = AC + 2;
}

:DMOVH "@AC+", "@"^dir9 is op8=0x1D & dir9 {	
	*:2 dir9 = (*:2 AC);
	AC = AC + 2;
}

:DMOVB "@"^dir9, "AC" is op8=0x0A & dir9 {
	AC = zext(*:1 dir9);
}

:DMOVB "AC", "@"^dir9 is op8=0x1A & dir9 {
	*:1 dir9 = AC:1;
}

:DMOVB "@"^dir9, "@AC+" is op8=0x0E & dir9 {	
	*:1 AC = (*:1 dir9);
	AC = AC + 1;
}

:DMOVB "@AC+", "@"^dir9 is op8=0x1E & dir9 {	
	*:1 dir9 = (*:1 AC);
	AC = AC + 1;
}

# Register-list operands: loads build upward; stores build downward.
ldm_r7: r7 is r7 & listbit7=1 { r7 = *:4 SP; SP = SP + 4; }
ldm_r7: "" is listbit7=0 { }

ldm_r6: r6 is r6 & ldm_r7 & listbit6=1 & listtail6=0 { r6 = *:4 SP; SP = SP + 4; build ldm_r7; }
ldm_r6: r6,ldm_r7 is r6 & ldm_r7 & listbit6=1 { r6 = *:4 SP; SP = SP + 4; build ldm_r7; }
ldm_r6: ldm_r7 is ldm_r7 & listbit6=0 { build ldm_r7; }

ldm_r5: r5 is r5 & ldm_r6 & listbit5=1 & listtail5=0 { r5 = *:4 SP; SP = SP + 4; build ldm_r6; }
ldm_r5: r5,ldm_r6 is r5 & ldm_r6 & listbit5=1 { r5 = *:4 SP; SP = SP + 4; build ldm_r6; }
ldm_r5: ldm_r6 is ldm_r6 & listbit5=0 { build ldm_r6; }

ldm_r4: r4 is r4 & ldm_r5 & listbit4=1 & listtail4=0 { r4 = *:4 SP; SP = SP + 4; build ldm_r5; }
ldm_r4: r4,ldm_r5 is r4 & ldm_r5 & listbit4=1 { r4 = *:4 SP; SP = SP + 4; build ldm_r5; }
