# MACRO FLAG HELPERS
macro set_add_flags(a, b, result) {
	set_nz(result);
	C = carry(a, b);
	V = scarry(a, b);
}

macro set_addc_flags(a, b, cin, result) {
    local temp:4 = a + b;

    set_nz(result);

    C = carry(a, b) | carry(temp, cin);
    V = scarry(a, b) ^ scarry(temp, cin);
}

macro set_sub_flags(a, b, result) {
	set_nz(result);
	C = a < b;
	V = sborrow(a, b);
}

macro set_subc_flags(a, b, cin, result) {
    local temp:4 = a - b;

    set_nz(result);

    C = (a < b) | (temp < cin);
    V = sborrow(a, b) ^ sborrow(temp, cin);
}

# ==========
# ADD Rj, Ri 
# ==========
:ADD Rjreg, Rireg is op8=0xA6 & Rjreg & Rireg
{	
	local result:4 = Rireg + Rjreg;
	
	set_add_flags(Rireg,Rjreg,result);
	Rireg = result;
}

# ===========
# ADD #u4, Ri
# ===========
:ADD "#"^u4, Rireg is op8=0xA4 & u4 & Rireg
{	
	local u:4 = u4;
	local result:4 = Rireg + u;
	
	set_add_flags(u,Rireg,result);
	Rireg = result;
}

# ============
# ADD2 #n4, Ri
# ============
:ADD2 "#"^n4, Rireg is op8=0xA5 & n4 & Rireg
{
    local result:4 = Rireg + n4;
    set_add_flags(Rireg, n4, result);
	Rireg = result;
}

# ===========
# ADDC Rj, Ri 
# ===========
:ADDC Rjreg, Rireg is op8=0xA7 & Rjreg & Rireg
{
    local cin:4 = zext(C);
    local result:4 = Rireg + Rjreg + cin;

    set_addc_flags(Rireg, Rjreg, cin, result);
    Rireg = result;
}

# ===========
# ADDN Rj, Ri
# ===========
:ADDN Rjreg, Rireg is op8=0xA2 & Rjreg & Rireg
{
	Rireg = Rireg + Rjreg;
}

# ============
# ADDN #u4, Ri
# ============
:ADDN "#"^u4, Rireg is op8=0xA0 & u4 & Rireg
{
	local u:4 = u4;
	local result:4 = u + Rireg;
	
	Rireg = result;
}

# =============
# ADDN2 #n4, Ri
# =============
:ADDN2 "#"^n4, Rireg is op8=0xA1 & n4 & Rireg
{
    Rireg = Rireg + n4;
}

# ==========
# SUB Rj, Ri 
# ==========
:SUB Rjreg, Rireg is op8=0xAC & Rjreg & Rireg 
{
	local result:4 = Rireg - Rjreg;
	
	set_sub_flags(Rireg,Rjreg,result);
	Rireg = result;
}

# ===========
# SUBC Rj, Ri 
# ===========
:SUBC Rjreg, Rireg is op8=0xAD & Rjreg & Rireg 
{	
    local cin:4 = zext(C);
    local result:4 = Rireg - Rjreg - cin;

    set_subc_flags(Rireg,Rjreg,cin,result);
    Rireg = result;
}

# ===========
# SUBN Rj, Ri
# ===========
:SUBN Rjreg, Rireg is op8=0xAE & Rjreg & Rireg
{
	Rireg = Rireg - Rjreg;
}

# ==========
# CMP Rj, Ri 
# ==========
:CMP Rjreg, Rireg is op8=0xAA & Rjreg & Rireg
{	
	local result:4 = Rireg - Rjreg;
	
	set_sub_flags(Rireg,Rjreg,result);
}

# ===========
# CMP #u4, Ri
# ===========
:CMP "#"^u4, Rireg is op8=0xA8 & u4 & Rireg
{
	local u:4 = u4;
	local result:4 = Rireg - u;
	
	set_sub_flags(Rireg,u,result);
}

# ============
# CMP2 #n4, Ri
# ============
:CMP2 "#"^n4, Rireg is op8=0xA9 & n4 & Rireg
{
    local result:4 = Rireg - n4;
    set_sub_flags(Rireg, n4, result);
}

# =========
# STILM #u8
# =========
:STILM "#"^u8 is op8=0x87 & u8
{
    local old:1 = ILM;
    local new:1 = u8 & 0x1F;

    if (old < 16) goto <load>;
    if (new >= 16) goto <load>;

    new = new + 16;

	<load>
    ILM = new;
}

# =============
# ADDSP #disp10
# =============
:ADDSP "#"^disp10 is op8=0xA3 & disp10
{
	SP = SP + disp10;
}