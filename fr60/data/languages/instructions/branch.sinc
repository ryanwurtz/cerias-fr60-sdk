# =========
# JMP:D @Ri
# =========
:"JMP:D" "@"^Rireg is op12=0x9F0 & Rireg & Ri
{
	delayslot(1);
	local data:4;
	read_ri(Ri, Rireg, data);
	goto [data];	
}

# ==============
# CALL:D label12
# ==============
:"CALL:D" label12 is op5=0x1B & label12
{
	RP = inst_next;
	delayslot(1);
	call label12;
}

# ==========
# CALL:D @Ri
# ==========
:"CALL:D" "@"^Rireg is op12=0x9F1 & Rireg & Ri
{	
	RP = inst_next;
	delayslot(1);
	
	local data:4;
	read_ri(Ri, Rireg, data);
	
	call [data];
}

# =====
# RET:D
# =====
:"RET:D" is op16=0x9F20
{	
	delayslot(1);
	return [RP];
}

# ============
# BRA:D label9
# ============
:"BRA:D" label9 is op4=0xF & cc=0x0 & label9
{	
	delayslot(1);
	goto label9;
}

# ============
# BNO:D label9
# ============
:"BNO:D" label9 is op4=0xF & cc=0x1 & label9
{	
	delayslot(1);
	# never taken
}

# ============
# BEQ:D label9
# ============
:"BEQ:D" label9 is op4=0xF & cc=0x2 & label9
{
    local take:1 = (Z == 1);

    delayslot(1);

    if (take == 0) goto <done>;
    goto label9;
	<done>
}

