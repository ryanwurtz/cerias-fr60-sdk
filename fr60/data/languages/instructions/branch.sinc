# =======
# JMP @Ri
# =======
:JMP "@"^Rireg is op12=0x970 & Rireg & Ri
{
	local data:4;
	read_ri(Ri, Rireg, data);
	
	goto [data];	
}

# ============
# CALL label12
# ============
:CALL label12 is op5=0x1A & label12
{
	RP = inst_next;
	call label12;
}

# ========
# CALL @Ri
# ========
:CALL "@"^Rireg is op12=0x971 & Rireg & Ri
{	
	local data:4;
	read_ri(Ri, Rireg, data);
	
	RP = inst_next;
	call [data];
}

# ===
# RET
# ===
:RET is op16=0x9720
{
	return [RP];
}

# =======
# INT #u8
# =======
:INT "#"^u8 is op8=0x1F & u8
{
	SSP = SSP - 4;
	writew(SSP, PS);
	SSP = SSP - 4;
	local nextpc:4 = inst_next;
	writew(SSP, nextpc);
	S = 0;
	I = 0;
	
	local u:4 = u8;
	local addr:4 = TBR + 0x03FC - u * 4;
	local data:4;
	
	readw(addr, data);
	goto [data];
}

# ====
# INTE
# ====
:INTE is op16=0x9F30
{
	SSP = SSP - 4;
	writew(SSP, PS);
	SSP = SSP - 4;
	local nextpc:4 = inst_next;
	writew(SSP, nextpc);
	ILM = 0;
	S = 0;

	local addr:4 = TBR + 0x3D8;
	local data:4;
	
	readw(addr, data);
	goto [data];
}

# ====
# RETI
# ====
:RETI is op16=0x9730
{
    local addr:4;
    local pcdata:4;
    local psdata:4;

    addr = SSP;

    readw(addr, pcdata);
    addr = addr + 4;

    readw(addr, psdata);
    addr = addr + 4;

    SSP = addr;
    write_ps(psdata);
    return [pcdata];
}

# ==========
# BRA label9
# ==========
:BRA label9 is op4=0xE & cc=0x0 & label9
{
	goto label9;
}

# ==========
# BNO label9
# ==========
:BNO label9 is op4=0xE & cc=0x1 & label9
{
	# never taken
}

# ==========
# BEQ label9
# ==========
:BEQ label9 is op4=0xE & cc=0x2 & label9
{	
	if (Z == 0) goto <done>;
	goto label9;
	<done>
}

# ==========
# BNE label9
# ==========
:BNE label9 is op4=0xE & cc=0x3 & label9
{	
	if (Z == 1) goto <done>;
	goto label9;
	<done>
}

