# ===
# NOP
# ===
:NOP is op16=0x9FA0
{
	#does nothing
}

# ============
# ENTER #dir10
# ============
:ENTER "#"^dir10 is op8=0x0F & dir10
{
	local addr:4;
	read_sp(addr);
	
	writew(addr - 4, FP);
	FP = addr - 4;
	write_sp(addr - dir10);
}

# =====
# LEAVE
# =====
:LEAVE is op16=0x9F90
{
    local data:4;
    local addr:4 = FP + 4;

    write_sp(addr);

    readw(addr - 4, data);
    FP = data;
}