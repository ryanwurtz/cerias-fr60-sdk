# ===============
# LDRES @Ri+, #u4
# ===============
:LDRES "@"^Rireg^"+, #"^u4 is op8=0xBC & u4 & Rireg & Ri
{
    local addr:4;
    local data:4;
    local u:1 = u4;

    read_ri(Ri, Rireg, addr);
    readw(addr, data);

    LDRES_OP(u, data);

    write_ri(Ri, Rireg, addr + 4);
}

# ===============
# STRES #u4, @Ri+
# ===============
:STRES "#"^u4^", @"^Rireg^"+" is op8=0xBD & u4 & Rireg & Ri
{
    local addr:4;
    local data:4;
    local u:1 = u4;

    read_ri(Ri, Rireg, addr);

    data = STRES_OP(u);

    writew(addr, data);

    write_ri(Ri, Rireg, addr + 4);
}

# ==========================
# COPOP #CPu4, #CC, CRj, CRi
# ==========================
:COPOP "#"^CPu4, "#"^CC, CRj, CRi is op12=0x9FC & CPu4 ; CC & CRj & CRi
{
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local cri:1 = CRi;
    local crj:1 = CRj;
	COPOP(CPu, cmd, crj, cri);
}

# =========================
# COPLD #CPu4, #CC, Rj, CRi
# =========================
:COPLD "#"^CPu4, "#"^CC, Rjreg, CRi is op12=0x9FD & CPu4 ; CC & Rjreg & Rj & CRi
{
    local data:4;
    read_rj(Rj, Rjreg, data);

    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local cri:1 = CRi;
    COPLD(CPu, cmd, cri, data);
}
	
# =========================
# COPST #CPu4, #CC, CRj, Ri
# =========================
:COPST "#"^CPu4, "#"^CC, CRj, Ri is op12=0x9FE & CPu4 ; CC & CRj & Rireg & Ri
{
	local data:4;
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local crj:1 = CRj;

    data = COPST(CPu, cmd, crj);
    write_ri(Ri, Rireg, data);
}
	
# =========================
# COPSV #CPu4, #CC, CRj, Ri
# =========================
:COPSV "#"^CPu4, "#"^CC, CRj, Ri is op12=0x9FF & CPu4 ; CC & CRj & Rireg & Ri
{
	local data:4;
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local crj:1 = CRj;

    data = COPSV(CPu, cmd, crj);
    write_ri(Ri, Rireg, data);
}