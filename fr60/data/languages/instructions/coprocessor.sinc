# ===============
# LDRES @Ri+, #u4
# ===============
:LDRES "@"^Rireg^"+, #"^u4 is op8=0xBC & u4 & Rireg
{
    local data:4;
    local u:1 = u4;

    readw(Rireg, data);
    LDRES_OP(u, data);
    Rireg = Rireg + 4;
}

# ===============
# STRES #u4, @Ri+
# ===============
:STRES "#"^u4^", @"^Rireg^"+" is op8=0xBD & u4 & Rireg
{
    local data:4;
    local u:1 = u4;

    data = STRES_OP(u);
    writew(Rireg, data);
    Rireg = Rireg + 4;
}

# ==========================
# COPOP #CPu4, #CC, CRj, CRi
# ==========================
:COPOP "#"^CPu4, "#"^CC, CRj, CRi is op12=0x9FC & CPu4 ; CC & CRj & CRi
{
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local cri:1 = CRi;
    local crj:1 = CRj;
	COPOP(CPu, cmd, crj, cri);
}

# =========================
# COPLD #CPu4, #CC, Rj, CRi
# =========================
:COPLD "#"^CPu4, "#"^CC, Rjreg, CRi is op12=0x9FD & CPu4 ; CC & Rjreg & CRi
{
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local cri:1 = CRi;
    COPLD(CPu, cmd, cri, Rjreg);
}
	
# =========================
# COPST #CPu4, #CC, CRj, Ri
# =========================
:COPST "#"^CPu4, "#"^CC, CRj, Rireg is op12=0x9FE & CPu4 ; CC & CRj & Rireg
{
	local data:4;
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local crj:1 = CRj;

    data = COPST(CPu, cmd, crj);
    Rireg = data;
}
	
# =========================
# COPSV #CPu4, #CC, CRj, Ri
# =========================
:COPSV "#"^CPu4, "#"^CC, CRj, Rireg is op12=0x9FF & CPu4 ; CC & CRj & Rireg
{
	local data:4;
    local CPu:1 = CPu4;
    local cmd:1 = CC;
    local crj:1 = CRj;

    data = COPSV(CPu, cmd, crj);
    Rireg = data;
}