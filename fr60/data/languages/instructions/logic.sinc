# ==========
# ANDCCR #u8
# ==========
:ANDCCR "#"^u8 is op8=0x83 & u8
{
	CCR = CCR & u8;
}

# =========
# ORCCR #u8
# =========
:ORCCR "#"^u8 is op8=0x93 & u8
{
	CCR = CCR | u8;
}

# ========
# EXTSB Ri
# ========
:EXTSB Rireg is op12=0x978 & Rireg
{	
	local data:4;
	read_ri(data);
	
	write_ri(sext(data:1));
}

# ========
# EXTUB Ri
# ========
:EXTUB Rireg is op12=0x979 & Rireg
{	
	local data:4;
	read_ri(data);
	
	write_ri(zext(data:1));
}

# ========
# EXTSH Ri
# ========
:EXTSH Rireg is op12=0x97A & Rireg
{	
	local data:4;
	read_ri(data);
	
	write_ri(sext(data:2));
}

# ========
# EXTUH Ri
# ========
:EXTUH Rireg is op12=0x97B & Rireg
{	
	local data:4;
	read_ri(data);
	
	write_ri(zext(data:2));
}