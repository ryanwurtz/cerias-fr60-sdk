# ==========
# AND Rj, Ri 
# ==========
:AND Rjreg, Rireg is op8=0x82 & Rjreg & Rireg
{	
	local result:4 = Rjreg & Rireg;
	
	set_nz(result);
	Rireg = result;
}

# ===========
# AND Rj, @Ri 
# ===========
:AND Rjreg, "@"^Rireg is op8=0x84 & Rjreg & Rireg
{	
	local mem:4;
	readw(Rireg,mem);
	local result:4 = Rjreg & mem;
	
	set_nz(result);
	writew(Rireg,result);
}

# ============
# ANDH Rj, @Ri 
# ============
:ANDH Rjreg, "@"^Rireg is op8=0x85 & Rjreg & Rireg
{	
	local mem:2;
	readh(Rireg,mem);
	local result:2 = Rjreg:2 & mem;
	
	set_nz(result);
	writeh(Rireg,result);
}

# ============
# ANDB Rj, @Ri 
# ============
:ANDB Rjreg, "@"^Rireg is op8=0x86 & Rjreg & Rireg
{
	local mem:1;
	readb(Rireg,mem);
	local result:1 = Rjreg:1 & mem;
	
	set_nz(result);
	writeb(Rireg, result);
}

# =========
# OR Rj, Ri 
# =========
:OR Rjreg, Rireg is op8=0x92 & Rjreg & Rireg
{	
	local result:4 = Rjreg | Rireg;
	
	set_nz(result);
	Rireg = result;
}

# ==========
# OR Rj, @Ri 
# ==========
:OR Rjreg, "@"^Rireg is op8=0x94 & Rjreg & Rireg
{
	local mem:4;
	readw(Rireg,mem);
	local result:4 = Rjreg | mem;
	
	set_nz(result);
	writew(Rireg,result);
}

