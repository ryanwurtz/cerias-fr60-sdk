# ==========
# ANDCCR #u8
# ==========
:ANDCCR "#"^u8 is op8=0x83 & u8
{
	CCR = CCR & u8;
}

# =========
# ORCCR #u8
# =========
:ORCCR "#"^u8 is op8=0x93 & u8
{
	CCR = CCR | u8;
}

# ========
# EXTSB Ri
# ========
:EXTSB Rireg is op12=0x978 & Rireg & Ri
{	
	local data:4;
	read_ri(Ri, Rireg, data);

	write_ri(Ri, Rireg, sext(data:1));
}

# ========
# EXTUB Ri
# ========
:EXTUB Rireg is op12=0x979 & Rireg & Ri
{	
	local data:4;
	read_ri(Ri, Rireg, data);

	write_ri(Ri, Rireg, zext(data:1));
}

# ========
# EXTSH Ri
# ========
:EXTSH Rireg is op12=0x97A & Rireg & Ri
{	
	local data:4;
	read_ri(Ri, Rireg, data);

	write_ri(Ri, Rireg, sext(data:2));
}

# ========
# EXTUH Ri
# ========
:EXTUH Rireg is op12=0x97B & Rireg & Ri
{	
	local data:4;
	read_ri(Ri, Rireg, data);

