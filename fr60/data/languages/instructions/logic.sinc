# ==========
# AND Rj, Ri 
# ==========
:AND Rjreg, Rireg is op8=0x82 & Rjreg & Rj & Rireg & Ri
{
	local a:4;
	local b:4;

	read_rj(Rj, Rjreg, a);
	read_ri(Ri, Rireg, b);
	
	local result:4 = a & b;
	
	set_nz(result);
	write_ri(Ri, Rireg, result);
}

# ===========
# AND Rj, @Ri 
# ===========
:AND Rjreg, "@"^Rireg is op8=0x84 & Rjreg & Rj & Rireg & Ri
{
	local a:4;
	local b:4;

	read_rj(Rj, Rjreg, a);
	read_ri(Ri, Rireg, b);
	
	local mem:4;
	readw(b,mem);
	local result:4 = a & mem;
	
	set_nz(result);
	writew(b,result);
}

# ============
# ANDH Rj, @Ri 
# ============
:ANDH Rjreg, "@"^Rireg is op8=0x85 & Rjreg & Rj & Rireg & Ri
{
	local a:4;
	local b:4;

	read_rj(Rj, Rjreg, a);
	read_ri(Ri, Rireg, b);
	
	local mem:2;
	readh(b,mem);
	local result:2 = a:2 & mem;
	
	set_nz(result);
	writeh(b,result);
}

# ============
# ANDB Rj, @Ri 
# ============
:ANDB Rjreg, "@"^Rireg is op8=0x86 & Rjreg & Rj & Rireg & Ri
{
	local a:4;
	local b:4;

	read_rj(Rj, Rjreg, a);
	read_ri(Ri, Rireg, b);
	
	local mem:1;
	readb(b,mem);
	local result:1 = a:1 & mem;
	
	set_nz(result);
	writeb(b,result);
}

