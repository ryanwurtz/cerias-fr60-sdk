:BORH "#"^u4, "@"^Rireg is op8=0x91 & u4 & Rireg & Ri
{
	local b:4;
	local u:1 = u4;
	read_ri(Ri, Rireg, b);
	
	local mem:1;
	readb(b,mem);
	local result:1 = (u << 4) | mem;
	
	writeb(b,result);
}

