# ==========
# AND Rj, Ri 
# ==========
:AND Rjreg, Rireg is op8=0x82 & Rjreg & Rireg
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b);
	
	local result:4 = a & b;
	
	set_nz(result);
	write_ri(result);
}

# ===========
# AND Rj, @Ri 
# ===========
:AND Rjreg, "@"^Rireg is op8=0x84 & Rjreg & Rireg
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b);
	
	local mem:4;
	readw(b,mem);
	local result:4 = a & mem;
	
	set_nz(result);
	writew(b,result);
}

# ============
# ANDH Rj, @Ri 
# ============
:ANDH Rjreg, "@"^Rireg is op8=0x85 & Rjreg & Rireg
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b);
	
	local mem:2;
	readh(b,mem);
	local result:2 = a:2 & mem;
	
	set_nz(result);
	writeh(b,result);
}

# ============
