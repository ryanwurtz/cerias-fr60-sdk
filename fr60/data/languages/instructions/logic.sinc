# ==============
# BANDL #u4, @Ri 
# ==============
:BANDL "#"^u4, "@"^Rireg is op8=0x80 & u4 & Rireg & Ri
{
	local b:4;
	local u:1 = u4;
	read_ri(Ri, Rireg, b);
	
	local mem:1;
	readb(b,mem);
	local mask:1 = 0xF0 | u;
	local result:1 = mask & mem;
	
	writeb(b,result);
}

# ==============
# BANDH #u4, @Ri 
# ==============
:BANDH "#"^u4, "@"^Rireg is op8=0x81 & u4 & Rireg & Ri
{
	local b:4;
	local u:1 = u4;
	read_ri(Ri, Rireg, b);
	
	local mem:1;
	readb(b,mem);
	local mask:1 = 0x0F | (u << 4);
	local result:1 = mask & mem;
	
	writeb(b,result);
}

# ==============
# BORL #u4, @Ri 
# ==============
:BORL "#"^u4, "@"^Rireg is op8=0x90 & u4 & Rireg & Ri
{
	local b:4;
	local u:1 = u4;
	read_ri(Ri, Rireg, b);
	
	local mem:1;
	readb(b,mem);
	local result:1 = u | mem;
	
	writeb(b,result);
}

# ==============
