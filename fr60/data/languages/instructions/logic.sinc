# ==============
# BANDL #u4, @Ri 
# ==============
:BANDL "#"^u4, "@"^Rireg is op8=0x80 & u4 & Rireg
{	
	local b:4;
	read_ri(b);
	
	local mem:1;
	readb(b,mem);
	local mask:1 = 0xF0 | zext(u4);
	local result:1 = mask & mem;
	
	writeb(b,result);
}

# ==============
# BANDH #u4, @Ri 
# ==============
:BANDH "#"^u4, "@"^Rireg is op8=0x81 & u4 & Rireg
{	
	local b:4;
	read_ri(b);
	
	local mem:1;
	readb(b,mem);
	local mask:1 = 0x0F | (zext(u4) << 4);
	local result:1 = mask & mem;
	
	writeb(b,result);
}

