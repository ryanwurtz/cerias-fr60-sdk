# ORH Rj, @Ri
# ===========
:ORH Rjreg, "@"^Rireg is op8=0x95 & Rjreg & Rireg
{
	local mem:2;
	readh(Rireg,mem);
	local result:2 = Rjreg:2 | mem;
	
	set_nz(result);
	writeh(Rireg,result);
}

# ===========
# ORB Rj, @Ri 
# ===========
:ORB Rjreg, "@"^Rireg is op8=0x96 & Rjreg & Rireg
{
	local mem:1;
	readb(Rireg,mem);
	local result:1 = Rjreg:1 | mem;
	
	set_nz(result);
	writeb(Rireg,result);
}

# ==========
# EOR Rj, Ri 
# ==========
:EOR Rjreg, Rireg is op8=0x9A & Rjreg & Rireg
{
	local result:4 = Rjreg ^ Rireg;
	
	set_nz(result);
	Rireg = result;
}

# ===========
# EOR Rj, @Ri 
# ===========
:EOR Rjreg, "@"^Rireg is op8=0x9C & Rjreg & Rireg
{
	local mem:4;
	readw(Rireg,mem);
	local result:4 = Rjreg ^ mem;
	
	set_nz(result);
	writew(Rireg,result);
}

# ============
# EORH Rj, @Ri
# ============
:EORH Rjreg, "@"^Rireg is op8=0x9D & Rjreg & Rireg
{
	local mem:2;
	readh(Rireg,mem);
	local result:2 = Rjreg:2 ^ mem;
	
	set_nz(result);
	writeh(Rireg,result);
}

# ===========
# EORB Rj, @Ri 
# ===========
:EORB Rjreg, "@"^Rireg is op8=0x9E & Rjreg & Rireg
{
	local mem:1;
	readb(Rireg,mem);
	local result:1 = Rjreg:1 ^ mem;
	
	set_nz(result);
	writeb(Rireg,result);
}

# ==============
# BANDL #u4, @Ri 
# ==============
:BANDL "#"^u4, "@"^Rireg is op8=0x80 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local mask:1 = 0xF0 | u;

	local result:1 = mask & mem;
	writeb(Rireg,result);
}

# ==============
# BANDH #u4, @Ri 
# ==============
:BANDH "#"^u4, "@"^Rireg is op8=0x81 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local mask:1 = 0x0F | (u << 4);

	local result:1 = mask & mem;
	writeb(Rireg,result);
}

# ==============
# BORL #u4, @Ri 
# ==============
:BORL "#"^u4, "@"^Rireg is op8=0x90 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local result:1 = u | mem;

	writeb(Rireg,result);
}

# ==============
# BORH #u4, @Ri 
# ==============
:BORH "#"^u4, "@"^Rireg is op8=0x91 & u4 & Rireg
{	
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local result:1 = (u << 4) | mem;
	
	writeb(Rireg,result);
}

# ==============
# BEORL #u4, @Ri 
# ==============
:BEORL "#"^u4, "@"^Rireg is op8=0x98 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local result:1 = u ^ mem;
	
	writeb(Rireg,result);
}

# ==============
# BEORH #u4, @Ri 
# ==============
:BEORH "#"^u4, "@"^Rireg is op8=0x99 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);

	local u:1 = u4;
	local result:1 = (u << 4) ^ mem;
	
	writeb(Rireg,result);
}

# ==============
# BTSTL #u4, @Ri 
# ==============
:BTSTL "#"^u4, "@"^Rireg is op8=0x88 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);
	
	local u:1 = u4;
	local result:1 = u & mem;

	set_nz(result);
}

# ==============
# BTSTH #u4, @Ri 
# ==============
:BTSTH "#"^u4, "@"^Rireg is op8=0x89 & u4 & Rireg
{
	local mem:1;
	readb(Rireg,mem);
	
	local u:1 = u4;
	local result:1 = (u << 4) & mem;

	set_nz(result);
}

# ==========
# ANDCCR #u8
# ==========
:ANDCCR "#"^u8 is op8=0x83 & u8
{
	CCR = CCR & u8;
}

# =========
# ORCCR #u8
# =========
:ORCCR "#"^u8 is op8=0x93 & u8
{
	CCR = CCR | u8;
}

# ========
# EXTSB Ri
# ========
:EXTSB Rireg is op12=0x978 & Rireg
{	
	Rireg = sext(Rireg:1);
}

# ========
# EXTUB Ri
# ========
:EXTUB Rireg is op12=0x979 & Rireg
{	
	Rireg =  zext(Rireg:1);
}

# ========
# EXTSH Ri
# ========
:EXTSH Rireg is op12=0x97A & Rireg
{
	Rireg = sext(Rireg:2);
}

# ========
# EXTUH Ri
# ========
:EXTUH Rireg is op12=0x97B & Rireg
{	
	Rireg = zext(Rireg:2);
}