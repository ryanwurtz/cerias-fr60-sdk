# DMOVB @dir9, AC
# ===============
:DMOVB "@"^dir9, "AC" is op8=0x0A & dir9
{
	readb(dir9, AC);
}

# ===============
# DMOVB AC, @dir9
# ===============
:DMOVB "AC", "@"^dir9 is op8=0x1A & dir9
{
	writeb(dir9, AC);
}

# =================
# DMOVB @dir9, @AC+
# =================
:DMOVB "@"^dir9, "@AC+" is op8=0x0E & dir9
{	
	local data:1;
	readb(dir9,data);
	
	writeb(AC, data);
	AC = AC + 1;
}

# =================
# DMOVB @AC+, @dir9
# =================
:DMOVB "@AC+", "@"^dir9 is op8=0x1E & dir9
{	
	local data:1;
	readb(AC,data);
	
	writeb(dir9, data);
	AC = AC + 1;
}

# ==============
# LDM0 (reglist)
# ==============
:LDM0 "("^reglist^")" is op8=0x8C & reglist
{
    local addr:4;
    read_sp(addr);

    if ((reglist & 0x01:1) == 0) goto <skip_r0>;
    readw(addr, r0);
    addr = addr + 4;
	<skip_r0>

    if ((reglist & 0x02:1) == 0) goto <skip_r1>;
    readw(addr, r1);
    addr = addr + 4;
	<skip_r1>

    if ((reglist & 0x04:1) == 0) goto <skip_r2>;
    readw(addr, r2);
    addr = addr + 4;
	<skip_r2>

    if ((reglist & 0x08:1) == 0) goto <skip_r3>;
    readw(addr, r3);
    addr = addr + 4;
	<skip_r3>

    if ((reglist & 0x10:1) == 0) goto <skip_r4>;
    readw(addr, r4);
    addr = addr + 4;
	<skip_r4>

    if ((reglist & 0x20:1) == 0) goto <skip_r5>;
    readw(addr, r5);
    addr = addr + 4;
	<skip_r5>

    if ((reglist & 0x40:1) == 0) goto <skip_r6>;
    readw(addr, r6);
    addr = addr + 4;
	<skip_r6>

    if ((reglist & 0x80:1) == 0) goto <skip_r7>;
    readw(addr, r7);
    addr = addr + 4;
	<skip_r7>

    write_sp(addr);
}

# ==============
# LDM1 (reglist)
# ==============
:LDM1 "("^reglist^")" is op8=0x8D & reglist
{
    local addr:4;
    local data:4;
    read_sp(addr);

    if ((reglist & 0x01:1) == 0) goto <skip_r8>;
    readw(addr, r8);
    addr = addr + 4;
	<skip_r8>

    if ((reglist & 0x02:1) == 0) goto <skip_r9>;
    readw(addr, r9);
    addr = addr + 4;
	<skip_r9>

    if ((reglist & 0x04:1) == 0) goto <skip_r10>;
    readw(addr, r10);
    addr = addr + 4;
	<skip_r10>

    if ((reglist & 0x08:1) == 0) goto <skip_r11>;
    readw(addr, r11);
    addr = addr + 4;
	<skip_r11>

    if ((reglist & 0x10:1) == 0) goto <skip_r12>;
    readw(addr, r12);
    addr = addr + 4;
	<skip_r12>

    if ((reglist & 0x20:1) == 0) goto <skip_r13>;
    readw(addr, AC);
    addr = addr + 4;
	<skip_r13>

    if ((reglist & 0x40:1) == 0) goto <skip_r14>;
    readw(addr, FP);
    addr = addr + 4;
	<skip_r14>

    if ((reglist & 0x80:1) == 0) goto <skip_r15>;
    readw(addr, data);
    addr = addr + 4;
    write_sp(data);
    goto <done>;

	<skip_r15>
    write_sp(addr);

	<done>
}

# ==============
# STM0 (reglist)
# ==============
:STM0 "("^reglist^")" is op8=0x8E & reglist
{
    local addr:4;
    read_sp(addr);

    if ((reglist & 0x80:1) == 0) goto <skip_r7>;
    addr = addr - 4;
    writew(addr, r7);
    <skip_r7>

    if ((reglist & 0x40:1) == 0) goto <skip_r6>;
    addr = addr - 4;
    writew(addr, r6);
    <skip_r6>

    if ((reglist & 0x20:1) == 0) goto <skip_r5>;
    addr = addr - 4;
    writew(addr, r5);
    <skip_r5>

    if ((reglist & 0x10:1) == 0) goto <skip_r4>;
    addr = addr - 4;
    writew(addr, r4);
    <skip_r4>

    if ((reglist & 0x08:1) == 0) goto <skip_r3>;
    addr = addr - 4;
    writew(addr, r3);
    <skip_r3>

    if ((reglist & 0x04:1) == 0) goto <skip_r2>;
    addr = addr - 4;
    writew(addr, r2);
    <skip_r2>

    if ((reglist & 0x02:1) == 0) goto <skip_r1>;
    addr = addr - 4;
    writew(addr, r1);
    <skip_r1>

    if ((reglist & 0x01:1) == 0) goto <skip_r0>;
    addr = addr - 4;
    writew(addr, r0);
    <skip_r0>

    write_sp(addr);
}

# ==============
# STM1 (reglist)
# ==============
:STM1 "("^reglist^")" is op8=0x8F & reglist
{
    local addr:4;
    local oldsp:4;
    
    read_sp(addr);
    oldsp = addr;

    if ((reglist & 0x80:1) == 0) goto <skip_r15>;
    addr = addr - 4;
    writew(addr, oldsp);
    <skip_r15>

    if ((reglist & 0x40:1) == 0) goto <skip_r14>;
    addr = addr - 4;
    writew(addr, FP);
    <skip_r14>

    if ((reglist & 0x20:1) == 0) goto <skip_r13>;
    addr = addr - 4;
    writew(addr, AC);
    <skip_r13>

    if ((reglist & 0x10:1) == 0) goto <skip_r12>;
    addr = addr - 4;
    writew(addr, r12);
    <skip_r12>

    if ((reglist & 0x08:1) == 0) goto <skip_r11>;
    addr = addr - 4;
    writew(addr, r11);
    <skip_r11>

    if ((reglist & 0x04:1) == 0) goto <skip_r10>;
    addr = addr - 4;
    writew(addr, r10);
    <skip_r10>

    if ((reglist & 0x02:1) == 0) goto <skip_r9>;
    addr = addr - 4;
    writew(addr, r9);
    <skip_r9>

    if ((reglist & 0x01:1) == 0) goto <skip_r8>;
    addr = addr - 4;
    writew(addr, r8);
    <skip_r8>

    write_sp(addr);
}

# ============
# XCHB @Rj, Ri
# ============
:XCHB "@"^Rjreg, Rireg is op8=0x8A & Rjreg & Rj & Rireg & Ri
{
	local ri_data:4;
	local addr:4;
	local mem_data:1;
	
	read_ri(Ri, Rireg, ri_data);
	read_rj(Rj, Rjreg, addr);
	readb(addr, mem_data);
	
	write_ri(Ri, Rireg, zext(mem_data));
	writeb(addr, ri_data:1);
}