# ===============
# LDI:32 #i32, Ri
# ===============
:LDI:32 "#"^i32, Rireg is op12=0x9F8 & Rireg & Ri ; i32
{
	write_ri(Ri, Rireg, i32);
}

# ===============
# LDI:20 #i20, Ri
# ===============
:LDI:20 "#"^i20, Rireg is (op8=0x9B & Rireg & Ri)  ... & i20
{
	write_ri(Ri, Rireg, i20);
}

# =============
# LDI:8 #i8, Ri
# =============
:LDI:8 "#"^i8, Rireg is op4=0xC & i8 & Rireg & Ri
{	
	local i:4 = i8;
	write_ri(Ri, Rireg, i);
}

# ==========
# LD @Rj, Ri
# ==========
:LD "@"^Rjreg, Rireg is op8=0x04 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	readw(addr,data);
	write_ri(Ri, Rireg, data);
}

# ================
# LD @(AC, Rj), Ri
# ================
:LD "@(AC, "^Rjreg^")", Rireg is op8=0x00 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	readw(addr + AC,data);
	write_ri(Ri, Rireg, data);
}

# ====================
# LD @(FP, disp10), Ri
# ====================
:LD "@(FP, "^disp10^")", Rireg is op4=0x2 & disp10 & Rireg & Ri
{
	local addr:4;
	local data:4;
	
	addr = FP + disp10;
	readw(addr,data);
	write_ri(Ri, Rireg, data);
}

# ====================
# LD @(SP, udisp6), Ri
# ====================
:LD "@(SP, "^udisp6^")", Rireg is op8=0x03 & udisp6 & Rireg & Ri
{
	local addr:4;
	local data:4;
	
	read_sp(addr);
	
	readw(addr + udisp6,data);
	write_ri(Ri, Rireg, data);
}

# ===========
# LD @SP+, Ri
# ===========
:LD "@SP+", Rireg is op12=0x070 & Rireg & Ri
{
    local addr:4;
    local data:4;

    read_sp(addr);
    readw(addr, data);

    if (Ri == 0xF:1) goto <active_sp>;

    write_ri(Ri, Rireg, data);
    write_sp(addr + 4);
    goto <done>;

	<active_sp>
    write_sp(addr + 4);
    write_ri(Ri, Rireg, data);

	<done>
}

# ===========
# LD @SP+, Rs
# ===========
:LD "@SP+", Rslreg is op12=0x078 & Rslreg & Rsl
{
	local addr:4;
	local data:4;
	
	read_sp(addr);
	readw(addr,data);
	
	if ((Rsl == 0x2:1) && (S == 0)) goto <active_sp>;
    if ((Rsl == 0x3:1) && (S == 1)) goto <active_sp>;
	
	Rslreg = data;
	write_sp(addr + 4);
	goto <done>;
	
	<active_sp>
	write_sp(addr + 4);
	Rslreg = data;
	
	<done>
}

# ===========
# LD @SP+, PS
# ===========
:LD "@SP+, PS" is op16=0x0790
{
	local addr:4;
    local data:4;
	local olds:1 = S;

    read_sp(addr);
    readw(addr, data);

    write_ps(data);
	
	if (olds == 1:1) goto <olduser>;
	SSP = addr + 4;
	goto <done>;
	
	<olduser>
	USP = addr + 4;
	
	<done>	
}

# ============
# LDUH @Rj, Ri
# ============
:LDUH "@"^Rjreg, Rireg is op8=0x05 & Rjreg & Rj & Rireg & Ri
{	
	local addr:4;
	local data:2;
	
	read_rj(Rj, Rjreg, addr);
	readh(addr,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# ==================
# LDUH @(AC, Rj), Ri
# ==================
:LDUH "@(AC, "^Rjreg^")", Rireg is op8=0x01 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:2;
	
	read_rj(Rj, Rjreg, addr);
	readh(AC + addr,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# =====================
# LDUH @(FP, disp9), Ri
# =====================
:LDUH "@(FP, "^disp9^")", Rireg is op4=0x4 & disp9 & Rireg & Ri
{
	local data:2;
	
	readh(FP + disp9,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# ============
# LDUB @Rj, Ri
# ============
:LDUB "@"^Rjreg, Rireg is op8=0x06 & Rjreg & Rj & Rireg & Ri
{	
	local addr:4;
	local data:1;
	
	read_rj(Rj, Rjreg, addr);
	readb(addr,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# ==================
# LDUB @(AC, Rj), Ri
# ==================
:LDUB "@(AC, "^Rjreg^")", Rireg is op8=0x02 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:1;
	
	read_rj(Rj, Rjreg, addr);
	readb(AC + addr,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# =====================
# LDUB @(FP, disp8), Ri
# =====================
:LDUB "@(FP, "^s8^")", Rireg is op4=0x6 & s8 & Rireg & Ri
{
	local data:1;
	
	readb(FP + s8,data);
	
	write_ri(Ri, Rireg, zext(data));
}

# ==========
# ST Ri, @Rj
# ==========
:ST Rireg, "@"^Rjreg is op8=0x14 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writew(addr,data);
}

# =================
# ST Ri, @(R13, Rj)
# =================
:ST Rireg, "@(AC, "^Rjreg^")" is op8=0x10 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writew(AC + addr,data);
}

# ====================
# ST Ri, @(FP, disp10)
# ====================
:ST Rireg, "@(FP, "^disp10^")" is op4=0x3 & disp10 & Rireg & Ri
{
	local data:4;

	read_ri(Ri, Rireg, data);
	writew(FP + disp10,data);
}

# ====================
# ST Ri, @(SP, udisp6)
# ====================
:ST Rireg, "@(SP, "^udisp6^")" is op8=0x13 & udisp6 & Rireg & Ri
{	
	local addr:4;
	local data:4;
	
	read_sp(addr);
	read_ri(Ri, Rireg, data);
	writew(addr + udisp6,data);
}

# ===========
# ST Ri, @-SP
# ===========
:ST Rireg, "@-SP" is op12=0x170 & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_ri(Ri, Rireg, data);
	read_sp(addr);
	addr = addr - 4;
	
	write_sp(addr);
	writew(addr,data);
}

# ===========
# ST Rs, @-SP
# ===========
:ST Rslreg, "@-SP" is op12=0x178 & Rslreg
{
	local addr:4;

	read_sp(addr);
	addr = addr - 4;
	
	write_sp(addr);
	writew(addr,Rslreg);
}

# ===========
# ST PS, @-SP
# ===========
:ST "PS, @-SP" is op16=0x1790
{
	local addr:4;

	read_sp(addr);
	addr = addr - 4;
	
	write_sp(addr);
	writew(addr,PS);
}

# ===========
# STH Ri, @Rj
# ===========
:STH Rireg, "@"^Rjreg is op8=0x15 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writeh(addr,data:2);
}

# ==================
# STH Ri, @(R13, Rj)
# ==================
:STH Rireg, "@(AC, "^Rjreg^")" is op8=0x11 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writeh(AC + addr,data:2);
}

# ====================
# STH Ri, @(FP, disp9)
# ====================
:STH Rireg, "@(FP, "^disp9^")" is op4=0x5 & disp9 & Rireg & Ri
{
	local data:4;

	read_ri(Ri, Rireg, data);
	writeh(FP + disp9,data:2);
}

# ===========
# STB Ri, @Rj
# ===========
:STB Rireg, "@"^Rjreg is op8=0x16 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writeb(addr,data:1);
}

# ==================
# STB Ri, @(R13, Rj)
# ==================
:STB Rireg, "@(AC, "^Rjreg^")" is op8=0x12 & Rjreg & Rj & Rireg & Ri
{
	local addr:4;
	local data:4;

	read_rj(Rj, Rjreg, addr);
	read_ri(Ri, Rireg, data);
	writeb(AC + addr,data:1);
}

# ====================
# STB Ri, @(FP, disp8)
# ====================
:STB Rireg, "@(FP, "^s8^")" is op4=0x7 & s8 & Rireg & Ri
{
	local data:4;

	read_ri(Ri, Rireg, data);
	writeb(FP + s8,data:1);
}

# ==========
# MOV Rj, Ri
# ==========
:MOV Rjreg, Rireg is op8=0x8B & Rjreg & Rj & Rireg & Ri
{
	local data:4;

	read_rj(Rj, Rjreg, data);
	write_ri(Ri, Rireg, data);
}

# ==========
# MOV Rs, Ri
# ==========
:MOV Rshreg, Rireg is op8=0xB7 & Rshreg & Rireg & Ri
{
	write_ri(Ri, Rireg, Rshreg);
}

# ==========
# MOV PS, Ri
# ==========
:MOV "PS", Rireg is op12=0x171 & Rireg & Ri
{
	write_ri(Ri, Rireg, PS);
}

# ==========
# MOV Ri, Rs
# ==========
:MOV Rireg, Rshreg is op8=0xB3 & Rshreg & Rireg & Ri
{
	local data:4;

	read_ri(Ri, Rireg, data);
	Rshreg = data;
}

# ==========
# MOV Ri, PS
# ==========
:MOV Rireg, "PS" is op12=0x071 & Rireg & Ri
{
	local data:4;

	read_ri(Ri, Rireg, data);
	write_ps(data);
}

# ===============
# DMOV @dir10, AC
# ===============
:DMOV "@"^dir10, "AC" is op8=0x08 & dir10
{
	readw(dir10, AC);
}

# ===============
# DMOV AC, @dir10
# ===============
:DMOV "AC", "@"^dir10 is op8=0x18 & dir10
{
	writew(dir10, AC);
}

# =================
# DMOV @dir10, @AC+
# =================
:DMOV "@"^dir10, "@AC+" is op8=0x0C & dir10
{	
	local data:4;
	readw(dir10,data);
	
	writew(AC, data);
	AC = AC + 4;
}

# =================
# DMOV @AC+, @dir10
# =================
:DMOV "@AC+", "@"^dir10 is op8=0x1C & dir10
{	
	local data:4;
	readw(AC,data);
	
	writew(dir10, data);
	AC = AC + 4;
}

# =================
# DMOV @dir10, @-SP
# =================
:DMOV "@"^dir10, "@-SP" is op8=0x0B & dir10
{	
	local data:4;
	local addr:4;
	
	read_sp(addr);
	addr = addr - 4;
	readw(dir10,data);
	
	writew(addr, data);
	write_sp(addr);
}

# =================
# DMOV @SP+, @dir10
# =================
:DMOV "@SP+", "@"^dir10 is op8=0x1B & dir10
{	
	local data:4;
	local addr:4;
	
	read_sp(addr);
	readw(addr,data);
	
	writew(dir10, data);
	write_sp(addr + 4);
}

