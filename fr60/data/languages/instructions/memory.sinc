# DMOVH @dir9, AC
# ===============
:DMOVH "@"^dir9, "AC" is op8=0x09 & dir9
{
	readh(dir9, AC);
}

# ===============
# DMOVH AC, @dir9
# ===============
:DMOVH "AC", "@"^dir9 is op8=0x19 & dir9
{
	writeh(dir9, AC);
}

# =================
# DMOVH @dir9, @AC+
# =================
:DMOVH "@"^dir9, "@AC+" is op8=0x0D & dir9
{	
	local data:2;
	readh(dir9,data);
	
	writeh(AC, data);
	AC = AC + 2;
}

# =================
# DMOVH @AC+, @dir9
# =================
:DMOVH "@AC+", "@"^dir9 is op8=0x1D & dir9
{	
	local data:2;
	readh(AC,data);
	
	writeh(dir9, data);
	AC = AC + 2;
}

