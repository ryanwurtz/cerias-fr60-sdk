# ===============
# LDI:32 #i32, Ri
# ===============
:LDI:32 "#"^i32, Rireg is op12=0x9F8 & Rireg ; i32
{
	Rireg = i32;
}

# ===============
# LDI:20 #i20, Ri
# ===============
:LDI:20 "#"^i20, Rireg is (op8=0x9B & Rireg) ... & i20
{
	Rireg = i20;
}

# =============
# LDI:8 #i8, Ri
# =============
:LDI:8 "#"^i8, Rireg is op4=0xC & i8 & Rireg
{	
	local i:4 = i8;
	Rireg = i;
}

# ==========
# LD @Rj, Ri
# ==========
:LD "@"^Rjreg, Rireg is op8=0x04 & Rjreg & Rireg
{
	local data:4;
	readw(Rjreg,data);

	Rireg = data;
}

# ================
# LD @(AC, Rj), Ri
# ================
:LD "@(AC, "^Rjreg^")", Rireg is op8=0x00 & Rjreg & Rireg
{
	local data:4;
	readw(Rjreg + AC,data);

	Rireg = data;
}

# ====================
# LD @(FP, disp10), Ri
# ====================
:LD "@(FP, "^disp10^")", Rireg is op4=0x2 & disp10 & Rireg
{
	local data:4;
	readw(FP + disp10,data);

	Rireg = data;
}

# ====================
# LD @(SP, udisp6), Ri
# ====================
:LD "@(SP, "^udisp6^")", Rireg is op8=0x03 & udisp6 & Rireg
{
	local data:4;
	readw(SP + udisp6,data);

	Rireg = data;
}

# ===========
# LD @SP+, Ri
# ===========
:LD "@SP+", Rireg is op12=0x070 & Rireg
{
	local data:4;
	readw(SP, data);
	SP = SP + 4;
	Rireg = data;
}

# ===========
# LD @SP+, Rs
# ===========
:LD "@SP+", Rslreg is op12=0x078 & Rslreg
{
	local data:4;
	readw(SP, data);
	SP = SP + 4;
	Rslreg = data;
}

# ===========
# LD @SP+, PS
# ===========
:LD "@SP+, PS" is op16=0x0790
{
    local data:4;
	readw(SP, data);

    write_ps(data);
	SP = SP + 4;
}

# ============
# LDUH @Rj, Ri
# ============
:LDUH "@"^Rjreg, Rireg is op8=0x05 & Rjreg & Rireg
{	
	local data:2;
	readh(Rjreg,data);
	
	Rireg = zext(data);
}

# ==================
# LDUH @(AC, Rj), Ri
# ==================
:LDUH "@(AC, "^Rjreg^")", Rireg is op8=0x01 & Rjreg & Rireg
{
	local data:2;
	readh(AC + Rjreg,data);
	
	Rireg = zext(data);
}

# =====================
# LDUH @(FP, disp9), Ri
# =====================
:LDUH "@(FP, "^disp9^")", Rireg is op4=0x4 & disp9 & Rireg
{
	local data:2;
	
	readh(FP + disp9,data);
	Rireg = zext(data);
}

# ============
# LDUB @Rj, Ri
# ============
:LDUB "@"^Rjreg, Rireg is op8=0x06 & Rjreg & Rireg
{	
	local data:1;
	readb(Rjreg,data);
	
	Rireg = zext(data);
}

# ==================
# LDUB @(AC, Rj), Ri
# ==================
:LDUB "@(AC, "^Rjreg^")", Rireg is op8=0x02 & Rjreg & Rireg
{
	local data:1;
	readb(AC + Rjreg,data);
	
	Rireg = zext(data);
}

# =====================
# LDUB @(FP, disp8), Ri
# =====================
:LDUB "@(FP, "^s8^")", Rireg is op4=0x6 & s8 & Rireg
{
	local data:1;
	readb(FP + s8,data);
	
	Rireg = zext(data);
}

# ==========
# ST Ri, @Rj
# ==========
:ST Rireg, "@"^Rjreg is op8=0x14 & Rjreg & Rireg
{
	writew(Rjreg,Rireg);
}

# =================
# ST Ri, @(R13, Rj)
# =================
:ST Rireg, "@(AC, "^Rjreg^")" is op8=0x10 & Rjreg & Rireg
{
	writew(AC + Rjreg,Rireg);
}

# ====================
# ST Ri, @(FP, disp10)
# ====================
:ST Rireg, "@(FP, "^disp10^")" is op4=0x3 & disp10 & Rireg
{
	writew(FP + disp10,Rireg);
}

# ====================
# ST Ri, @(SP, udisp6)
# ====================
:ST Rireg, "@(SP, "^udisp6^")" is op8=0x13 & udisp6 & Rireg
{	
	writew(SP + udisp6,Rireg);
}

# ===========
# ST Ri, @-SP
# ===========
:ST Rireg, "@-SP" is op12=0x170 & Rireg
{	
	local data:4 = Rireg;
	SP = SP - 4;
	writew(SP,data);
}

# ===========
# ST Rs, @-SP
# ===========
:ST Rslreg, "@-SP" is op12=0x178 & Rslreg
{
	local data:4 = Rslreg;
	SP = SP - 4;
	writew(SP, data);
}

# ===========
# ST PS, @-SP
# ===========
:ST "PS, @-SP" is op16=0x1790
{
	SP = SP - 4;
	writew(SP,PS);
}

# ===========
# STH Ri, @Rj
# ===========
:STH Rireg, "@"^Rjreg is op8=0x15 & Rjreg & Rireg
{
	writeh(Rjreg,Rireg:2);
}

# ==================
# STH Ri, @(R13, Rj)
# ==================
:STH Rireg, "@(AC, "^Rjreg^")" is op8=0x11 & Rjreg & Rireg
{
	writeh(AC + Rjreg,Rireg:2);
}

# ====================
# STH Ri, @(FP, disp9)
# ====================
:STH Rireg, "@(FP, "^disp9^")" is op4=0x5 & disp9 & Rireg
{
	writeh(FP + disp9,Rireg:2);
}

# ===========
# STB Ri, @Rj
# ===========
:STB Rireg, "@"^Rjreg is op8=0x16 & Rjreg & Rireg
{
	writeb(Rjreg,Rireg:1);
}

# ==================
# STB Ri, @(R13, Rj)
# ==================
:STB Rireg, "@(AC, "^Rjreg^")" is op8=0x12 & Rjreg & Rireg
{
	writeb(AC + Rjreg,Rireg:1);
}

# ====================
# STB Ri, @(FP, disp8)
# ====================
:STB Rireg, "@(FP, "^s8^")" is op4=0x7 & s8 & Rireg
{
	writeb(FP + s8,Rireg:1);
}

# ==========
# MOV Rj, Ri
# ==========
:MOV Rjreg, Rireg is op8=0x8B & Rjreg & Rireg
{
	Rireg = Rjreg;
}

# ==========
# MOV Rs, Ri
# ==========
:MOV Rshreg, Rireg is op8=0xB7 & Rshreg & Rireg
{
	Rireg = Rshreg;
}

# ==========
# MOV PS, Ri
# ==========
:MOV "PS", Rireg is op12=0x171 & Rireg
{
	Rireg = PS;
}

# ==========
# MOV Ri, Rs
# ==========
:MOV Rireg, Rshreg is op8=0xB3 & Rshreg & Rireg
{
	Rshreg = Rireg;
}

# ==========
# MOV Ri, PS
# ==========
:MOV Rireg, "PS" is op12=0x071 & Rireg
{
	write_ps(Rireg);
}

# ===============
# DMOV @dir10, AC
# ===============
:DMOV "@"^dir10, "AC" is op8=0x08 & dir10
{
	readw(dir10, AC);
}

# ===============
# DMOV AC, @dir10
# ===============
:DMOV "AC", "@"^dir10 is op8=0x18 & dir10
{
	writew(dir10, AC);
}

# =================
# DMOV @dir10, @AC+
# =================
:DMOV "@"^dir10, "@AC+" is op8=0x0C & dir10
{	
	local data:4;
	readw(dir10,data);
	
	writew(AC, data);
	AC = AC + 4;
}

# =================
# DMOV @AC+, @dir10
# =================
:DMOV "@AC+", "@"^dir10 is op8=0x1C & dir10
{	
	local data:4;
	readw(AC,data);
	
	writew(dir10, data);
	AC = AC + 4;
}

# =================
# DMOV @dir10, @-SP
# =================
:DMOV "@"^dir10, "@-SP" is op8=0x0B & dir10
{	
	local data:4;
	readw(dir10,data);

	SP = SP - 4;
	writew(SP, data);
}

# =================
# DMOV @SP+, @dir10
# =================
:DMOV "@SP+", "@"^dir10 is op8=0x1B & dir10
{	
	local data:4;
	readw(SP,data);
	
	writew(dir10, data);
	SP = SP + 4;
}

# ===============
# DMOVH @dir9, AC
# ===============
:DMOVH "@"^dir9, "AC" is op8=0x09 & dir9
{
	readh(dir9, AC);
}

# ===============
# DMOVH AC, @dir9
# ===============
:DMOVH "AC", "@"^dir9 is op8=0x19 & dir9
{
	writeh(dir9, AC);
}

# =================
# DMOVH @dir9, @AC+
# =================
:DMOVH "@"^dir9, "@AC+" is op8=0x0D & dir9
{	
	local data:2;
	readh(dir9,data);
	
	writeh(AC, data);
	AC = AC + 2;
}

# =================
# DMOVH @AC+, @dir9
# =================
:DMOVH "@AC+", "@"^dir9 is op8=0x1D & dir9
{	
	local data:2;
	readh(AC,data);
	
	writeh(dir9, data);
	AC = AC + 2;
}

# ===============
# DMOVB @dir9, AC
# ===============
:DMOVB "@"^dir9, "AC" is op8=0x0A & dir9
{
	readb(dir9, AC);
}

# ===============
# DMOVB AC, @dir9
# ===============
:DMOVB "AC", "@"^dir9 is op8=0x1A & dir9
{
	writeb(dir9, AC);
}

# =================
# DMOVB @dir9, @AC+
# =================
:DMOVB "@"^dir9, "@AC+" is op8=0x0E & dir9
{	
	local data:1;
	readb(dir9,data);
	
	writeb(AC, data);
	AC = AC + 1;
}

# =================
# DMOVB @AC+, @dir9
# =================
:DMOVB "@AC+", "@"^dir9 is op8=0x1E & dir9
{	
	local data:1;
	readb(AC,data);
	
	writeb(dir9, data);
	AC = AC + 1;
}

# ==============
# LDM0 (reglist)
# ==============
:LDM0 "("^reglist^")" is op8=0x8C & reglist
{
    if ((reglist & 0x01:1) == 0) goto <skip_r0>;
    readw(SP, r0);
    SP = SP + 4;
	<skip_r0>

    if ((reglist & 0x02:1) == 0) goto <skip_r1>;
    readw(SP, r1);
    SP = SP + 4;
	<skip_r1>

    if ((reglist & 0x04:1) == 0) goto <skip_r2>;
    readw(SP, r2);
    SP = SP + 4;
	<skip_r2>

    if ((reglist & 0x08:1) == 0) goto <skip_r3>;
    readw(SP, r3);
    SP = SP + 4;
	<skip_r3>

    if ((reglist & 0x10:1) == 0) goto <skip_r4>;
    readw(SP, r4);
    SP = SP + 4;
	<skip_r4>

    if ((reglist & 0x20:1) == 0) goto <skip_r5>;
    readw(SP, r5);
    SP = SP + 4;
	<skip_r5>

    if ((reglist & 0x40:1) == 0) goto <skip_r6>;
    readw(SP, r6);
    SP = SP + 4;
	<skip_r6>

    if ((reglist & 0x80:1) == 0) goto <skip_r7>;
    readw(SP, r7);
    SP = SP + 4;
	<skip_r7>
}

# ==============
# LDM1 (reglist)
# ==============
:LDM1 "("^reglist^")" is op8=0x8D & reglist
{
    if ((reglist & 0x01:1) == 0) goto <skip_r8>;
    readw(SP, r8);
    SP = SP + 4;
	<skip_r8>

    if ((reglist & 0x02:1) == 0) goto <skip_r9>;
    readw(SP, r9);
    SP = SP + 4;
	<skip_r9>

    if ((reglist & 0x04:1) == 0) goto <skip_r10>;
    readw(SP, r10);
    SP = SP + 4;
	<skip_r10>

    if ((reglist & 0x08:1) == 0) goto <skip_r11>;
    readw(SP, r11);
    SP = SP + 4;
	<skip_r11>

    if ((reglist & 0x10:1) == 0) goto <skip_r12>;
    readw(SP, r12);
    SP = SP + 4;
	<skip_r12>

    if ((reglist & 0x20:1) == 0) goto <skip_r13>;
    readw(SP, AC);
    SP = SP + 4;
	<skip_r13>

    if ((reglist & 0x40:1) == 0) goto <skip_r14>;
    readw(SP, FP);
    SP = SP + 4;
	<skip_r14>

    if ((reglist & 0x80:1) == 0) goto <skip_r15>;
	local data:4;
    readw(SP, data);
    SP = SP + 4;
	SP = data;
	<skip_r15>
}

# ==============
# STM0 (reglist)
# ==============
:STM0 "("^reglist^")" is op8=0x8E & reglist
{
    if ((reglist & 0x80:1) == 0) goto <skip_r7>;
    SP = SP - 4;
    writew(SP, r7);
    <skip_r7>

    if ((reglist & 0x40:1) == 0) goto <skip_r6>;
    SP = SP - 4;
    writew(SP, r6);
    <skip_r6>

    if ((reglist & 0x20:1) == 0) goto <skip_r5>;
    SP = SP - 4;
    writew(SP, r5);
    <skip_r5>

    if ((reglist & 0x10:1) == 0) goto <skip_r4>;
    SP = SP - 4;
    writew(SP, r4);
    <skip_r4>

    if ((reglist & 0x08:1) == 0) goto <skip_r3>;
    SP = SP - 4;
    writew(SP, r3);
    <skip_r3>

    if ((reglist & 0x04:1) == 0) goto <skip_r2>;
    SP = SP - 4;
    writew(SP, r2);
    <skip_r2>

    if ((reglist & 0x02:1) == 0) goto <skip_r1>;
    SP = SP - 4;
    writew(SP, r1);
    <skip_r1>

    if ((reglist & 0x01:1) == 0) goto <skip_r0>;
    SP = SP - 4;
    writew(SP, r0);
    <skip_r0>
}

# ==============
# STM1 (reglist)
# ==============
:STM1 "("^reglist^")" is op8=0x8F & reglist
{
    local oldsp:4 = SP;   
	
    if ((reglist & 0x80:1) == 0) goto <skip_r15>;
    SP = SP - 4;
    writew(SP, oldsp);
    <skip_r15>

    if ((reglist & 0x40:1) == 0) goto <skip_r14>;
    SP = SP - 4;
    writew(SP, FP);
    <skip_r14>

    if ((reglist & 0x20:1) == 0) goto <skip_r13>;
    SP = SP - 4;
    writew(SP, AC);
    <skip_r13>

    if ((reglist & 0x10:1) == 0) goto <skip_r12>;
    SP = SP - 4;
    writew(SP, r12);
    <skip_r12>

    if ((reglist & 0x08:1) == 0) goto <skip_r11>;
    SP = SP - 4;
    writew(SP, r11);
    <skip_r11>

    if ((reglist & 0x04:1) == 0) goto <skip_r10>;
    SP = SP - 4;
    writew(SP, r10);
    <skip_r10>

    if ((reglist & 0x02:1) == 0) goto <skip_r9>;
    SP = SP - 4;
    writew(SP, r9);
    <skip_r9>

    if ((reglist & 0x01:1) == 0) goto <skip_r8>;
    SP = SP - 4;
    writew(SP, r8);
    <skip_r8>
}

# ============
# XCHB @Rj, Ri
# ============
:XCHB "@"^Rjreg, Rireg is op8=0x8A & Rjreg & Rireg
{
	local data:1;
	readb(Rjreg, data);
	
	writeb(Rjreg, Rireg:1);
	Rireg = zext(data);
}