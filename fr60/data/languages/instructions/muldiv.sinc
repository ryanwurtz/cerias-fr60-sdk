# ==========
# MUL Rj, Ri 
# ==========
:MUL Rjreg, Rireg is op8=0xAF & Rjreg & Rireg
{	
	local result:8 = sext(Rjreg) * sext(Rireg);
	
	MDH = result(4);
    MDL = result:4;

    N = (MDL s< 0);
    Z = (result == 0);
    V = (result != sext(MDL));
}

# ===========
# MULU Rj, Ri 
# ===========
:MULU Rjreg, Rireg is op8=0xAB & Rjreg & Rireg
{		
	local result:8 = zext(Rjreg) * zext(Rireg);
	
	MDH = result(4);
    MDL = result:4;

    N = (MDL s< 0);
    Z = (MDL == 0);
    V = (MDH != 0);
}

# ===========
# MULH Rj, Ri 
# ===========
:MULH Rjreg, Rireg is op8=0xBF & Rjreg & Rj & Rireg & Ri
{	
	local result:4 = sext(Rjreg:2) * sext(Rireg:2);
	
	MDL = result;
	set_nz(result);
}

# ============
# MULUH Rj, Ri 
# ============
:MULUH Rjreg, Rireg is op8=0xBB & Rjreg & Rireg
{	
	local result:4 = zext(Rjreg:2) * zext(Rireg:2);
	
	MDL = result;
	set_nz(result);
}

# ========
# DIV0S Ri 
# ========
:DIV0S Rireg is op12=0x974 & Rireg
{	
	D0 = (MDL s< 0);
	D1 = ((MDL s<0) ^ (Rireg s<0));

	local extended:8 = sext(MDL);
	MDH = extended(4);
}

# ========
# DIV0U Ri 
# ========
:DIV0U Rireg is op12=0x975 & Rireg
{	
	D0 = 0;
	D1 = 0;
	MDH = 0;
}

# =======
# DIV1 Ri 
# =======
:DIV1 Rireg is op12=0x976 & Rireg
{	
	local comb:8 = (zext(MDH) << 32) | zext(MDL);
	comb = comb << 1;
	MDH = comb(4);
	MDL = comb:4;
	
	local temp:4;
	if (D1 == 1) goto <add>;
	temp = MDH - Rireg;
	C = MDH < Rireg;
	goto <check>;
	<add>
	temp = MDH + Rireg;
	C = carry(MDH, Rireg);
	
	<check>
	if ((D0 ^ D1 ^ C) != 0) goto <done>;
	MDH = temp;
	MDL = MDL | 0x1;
	<done>
	Z = (MDH == 0);
}

# =======
# DIV2 Ri 
# =======
:DIV2 Rireg is op12=0x977 & Rireg
{	
	local temp:4;
	if (D1 == 1) goto <add>;
	temp = MDH - Rireg;
	C = MDH < Rireg;
	goto <check>;
	<add>
	temp = MDH + Rireg;
	C = carry(MDH, Rireg);
	
	<check>
	Z = (temp == 0);
	
	if (Z != 1) goto <done>;
	MDH = 0;
	<done>
}

# ====
# DIV3 
# ====
:DIV3 is op16=0x9F60
{	
	if (Z != 1) goto <done>;
	MDL = MDL + 1;
	<done>
}

# =====
# DIV4S
# =====
:DIV4S is op16=0x9F70
{	
	if (D1 != 1) goto <done>;
	MDL = 0 - MDL;
	<done>
}