# ==========
# ASR Rj, Ri
# ==========
:ASR Rjreg, Rireg is op8=0xBA & Rjreg & Rireg 
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b);
	
	local shift:1 = a:1 & 0x1F;
	local result:4 = b s>> shift;
	
	right_setc(shift, b);
	write_ri(result);
	set_nz(result);
}

