macro left_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (32-shift)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

macro right_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (shift-1)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

# ==========
# LSL Rj, Ri
# ==========
:LSL Rjreg, Rireg is op8=0xB6 & Rjreg & Rireg
{	
	local shift:1 = Rjreg:1 & 0x1F;
	local result:4 = Rireg << shift;
	
	left_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}

# ===========
# LSL #u4, Ri
# ===========
:LSL "#"^u4, Rireg is op8=0xB4 & u4 & Rireg
{	
	local u:4 = u4;
	local result:4 = Rireg << u;
	
	left_setc(u, Rireg);
	Rireg = result;
	set_nz(result);
}

# ============
# LSL2 #u4, Ri
# ============
:LSL2 "#"^u4, Rireg is op8=0xB5 & u4 & Rireg
{	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = Rireg << shift;
	
	left_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}

# ==========
# LSR Rj, Ri
# ==========
:LSR Rjreg, Rireg is op8=0xB2 & Rjreg & Rireg
{	
	local shift:1 = Rjreg:1 & 0x1F:1;
	local result:4 = Rireg >> shift;
	
	right_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}

# ===========
# LSR #u4, Ri
# ===========
:LSR "#"^u4, Rireg is op8=0xB0 & u4 & Rireg
{	
	local u:4 = u4;
	local result:4 = Rireg >> u;
	
	right_setc(u, Rireg);
	Rireg = result;
	set_nz(result);
}

# ============
# LSR2 #u4, Ri
# ============
:LSR2 "#"^u4, Rireg is op8=0xB1 & u4 & Rireg
{	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = Rireg >> shift;
	
	right_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}

# ==========
# ASR Rj, Ri
# ==========
:ASR Rjreg, Rireg is op8=0xBA & Rjreg & Rireg
{	
	local shift:1 = Rjreg:1 & 0x1F;
	local result:4 = Rireg s>> shift;
	
	right_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}

# ===========
# ASR #u4, Ri
# ===========
:ASR "#"^u4, Rireg is op8=0xB8 & u4 & Rireg
{	
	local u:4 = u4;
	local result:4 = Rireg s>> u;
	
	right_setc(u, Rireg);
	Rireg = result;
	set_nz(result);
}

# ============
# ASR2 #u4, Ri
# ============
:ASR2 "#"^u4, Rireg is op8=0xB9 & u4 & Rireg
{	
	local u:4 = u4;
	local shift:4 = u + 16;
	local result:4 = Rireg s>> shift;
	
	right_setc(shift, Rireg);
	Rireg = result;
	set_nz(result);
}