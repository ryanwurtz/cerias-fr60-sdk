macro left_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (32-shift)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

macro right_setc(shift, dest) {
	if (shift == 0) goto <clear>;
	C = (((dest >> (shift-1)) & 0x1) == 1);
	goto <done>;
	<clear>
	C = 0;
	<done>
}

# ==========
# LSL Rj, Ri
# ==========
:LSL Rjreg, Rireg is op8=0xB6 & Rjreg & Rireg 
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b);
	
	local shift:1 = a:1 & 0x1F;
	local result:4 = b << shift;
	
	left_setc(shift, b);
	write_ri(result);
	set_nz(result);
}

# ===========
# LSL #u4, Ri
# ===========
:LSL "#"^u4, Rireg is op8=0xB4 & u4 & Rireg 
{	
	local b:4;
	read_ri(b);
	
	local result:4 = b << zext(u4);
	
	left_setc(zext(u4), b);
	write_ri(result);
	set_nz(result);
}

# ============
# LSL2 #u4, Ri
# ============
:LSL2 "#"^u4, Rireg is op8=0xB5 & u4 & Rireg 
{	
	local b:4;
	read_ri(b);
	
	local shift:1 = zext(u4) + 16;
	local result:4 = b << shift;
	
	left_setc(shift, b);
	write_ri(result);
	set_nz(result);
}

# ==========
# LSR Rj, Ri
# ==========
:LSR Rjreg, Rireg is op8=0xB2 & Rjreg & Rireg 
{	
	local a:4;
	local b:4;
	
	read_rj(a);
	read_ri(b); 
	
	local shift:1 = a:1 & 0x1F;
	local result:4 = b >> shift;
	
	right_setc(shift, b);
	write_ri(result);
	set_nz(result);
}

